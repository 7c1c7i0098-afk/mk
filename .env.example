# Database — SQLite for local development, PostgreSQL in production
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Session signing key — must be at least 32 characters (required in production)
AUTH_SECRET="change-me-to-a-long-random-string-32+"

# Encryption key for supplier API credentials — at least 32 characters.
# Falls back to AUTH_SECRET when unset. Rotating it makes every stored
# supplier secret unreadable, so re-enter them in Admin after a change.
SUPPLIER_ENCRYPTION_KEY=""

# Public origin, used to build the OAuth callback URLs
APP_URL="http://localhost:3000"

# ── Google Sign-In ───────────────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# Authorised redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Sign in with Apple ───────────────────────────────────────────────────────
# developer.apple.com → Certificates, Identifiers & Profiles
# APPLE_CLIENT_ID is the Services ID, not the App ID.
# Return URL: {APP_URL}/api/auth/apple/callback
# APPLE_PRIVATE_KEY is the .p8 contents; keep the \n escapes on one line.
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# ── Email delivery for OTP codes ─────────────────────────────────────────────
# resend.com → API Keys. While empty, codes are printed to the server log
# (development only — sending is refused in production).
RESEND_API_KEY=""
MAIL_FROM="PLUS CARD <onboarding@resend.dev>"
